<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notification_surface"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:background="@drawable/notification_brand_bg"
            android:contentDescription="V2S"
            android:src="@drawable/ic_notification_v2s" />

        <TextView
            android:id="@+id/notification_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="V2S  •  0 sec"
            android:textColor="@color/notification_secondary_text"
            android:textStyle="bold"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/notification_expand"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="@drawable/notification_control_bg"
            android:contentDescription="Expand"
            android:src="@drawable/ic_notification_expand_more" />

        <ImageView
            android:id="@+id/notification_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:padding="8dp"
            android:background="@drawable/notification_control_bg"
            android:contentDescription="Close notification and application"
            android:src="@drawable/ic_notification_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/notification_primary_text"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/notification_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/notification_secondary_text"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/notification_control_bg"
            android:contentDescription="Previous track"
            android:src="@drawable/ic_notification_prev" />

        <ImageView
            android:id="@+id/notification_seek_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:padding="8dp"
            android:background="@drawable/notification_control_bg"
            android:contentDescription="Back 10 seconds"
            android:src="@drawable/ic_notification_seek_back" />

        <ImageView
            android:id="@+id/notification_play_pause"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:padding="10dp"
            android:background="@drawable/notification_play_control_bg"
            android:contentDescription="Play or pause"
            android:src="@drawable/ic_notification_play" />

        <ImageView
            android:id="@+id/notification_seek_forward"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:padding="8dp"
            android:background="@drawable/notification_control_bg"
            android:contentDescription="Forward 10 seconds"
            android:src="@drawable/ic_notification_seek_forward" />

        <ImageView
            android:id="@+id/notification_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/notification_control_bg"
            android:contentDescription="Next track"
            android:src="@drawable/ic_notification_next" />
    </LinearLayout>
</LinearLayout>
